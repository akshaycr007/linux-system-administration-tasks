cd k8s-ha-ansible/roles/k8s_master/tasks/main.yml

---
- name: Initialize Kubernetes cluster
  command: kubeadm init --control-plane-endpoint "{{ vip_hostname }}:8443" --upload-certs
  args:
    creates: /etc/kubernetes/admin.conf

- name: Configure kubeconfig for root user
  shell: |
    mkdir -p /root/.kube
    cp -i /etc/kubernetes/admin.conf /root/.kube/config
    chown $(id -u):$(id -g) /root/.kube/config
  args:
    creates: /root/.kube/config

- name: Configure kubeconfig for ubuntu user
  shell: |
    mkdir -p /home/ubuntu/.kube
    cp -i /etc/kubernetes/admin.conf /home/ubuntu/.kube/config
    chown -R ubuntu:ubuntu /home/ubuntu/.kube
  args:
    creates: /home/ubuntu/.kube/config

- name: Install Calico CNI
  command: kubectl create -f https://raw.githubusercontent.com/projectcalico/calico/v3.32.2/manifests/calico.yaml
  ignore_errors: yes

- name: Generate join command
  command: kubeadm token create --print-join-command
  register: join_cmd_raw

- name: Generate certificate key for control plane
  command: kubeadm init phase upload-certs --upload-certs
  register: cert_key_raw

- name: Store join facts
  set_fact:
    worker_join: "{{ join_cmd_raw.stdout }}"
    master_join: "{{ join_cmd_raw.stdout }} --control-plane --certificate-key {{ cert_key_raw.stdout_lines[-1] }}"


