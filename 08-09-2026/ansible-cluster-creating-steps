cd k8s-ha-ansible/roles/loadbalancer/templates/haproxy.cfg.j2

global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    user haproxy
    group haproxy
    daemon

defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    timeout connect 5000ms
    timeout client  50000ms
    timeout server  50000ms

frontend k8s-api
    bind {{ vip_hostname }}:8443
    mode tcp
    option tcplog
    default_backend k8s-api-backend

backend k8s-api-backend
    mode tcp
    option tcp-check
    balance roundrobin
    default-server inter 10s downinter 5s rise 2 fall 2 slowstart 60s maxconn 250 maxqueue 256 weight 100
{% for host in groups['masters'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:6443 check
{% endfor %}

step8
cd k8s-ha-ansible/roles/loadbalancer/templates/keepalived.conf.j2

vrrp_script check_haproxy {
    script "killall -0 haproxy"
    interval 2
    weight 2
}

vrrp_instance VI_1 {
    state {{ keepalived_state }}
    interface ens160
    virtual_router_id 51
    priority {{ keepalived_priority }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass K8sApiVipPass123
    }

    unicast_src_ip {{ ansible_host }}
    unicast_peer {
{% for host in groups['masters'] %}
{% if host != inventory_hostname %}
        {{ hostvars[host]['ansible_host'] }}
{% endif %}
{% endfor %}
    }

    virtual_ipaddress {
        {{ vip_ip }}/24 dev ens160
    }

    track_script {
        check_haproxy
    }
}

