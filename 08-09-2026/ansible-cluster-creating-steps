cd k8s-ha-ansible roles/common/tasks/main.yml

---
- name: Add hosts mapping
  lineinfile:
    path: /etc/hosts
    line: "{{ item }}"
    state: present
  loop:
    - "172.30.7.131 tsb-dev-play-k8m1"
    - "172.30.7.132 tsb-dev-play-k8m2"
    - "172.30.7.144 tsb-dev-playground1"
    - "172.30.7.133 tsb-dev-play-k8w1"
    - "172.30.7.130 k8s-api.local"

- name: Disable swap
  command: swapoff -a

- name: Disable swap in fstab
  replace:
    path: /etc/fstab
    regexp: '^([^#].*?\sswap\s+sw\s+.*)$'
    replace: '# \1'

- name: Load kernel modules
  modprobe:
    name: "{{ item }}"
    state: present
  loop:
    - overlay
    - br_netfilter

- name: Set sysctl parameters
  sysctl:
    name: "{{ item.name }}"
    value: "{{ item.value }}"
    state: present
    reload: yes
  loop:
    - { name: 'net.bridge.bridge-nf-call-iptables', value: '1' }
    - { name: 'net.bridge.bridge-nf-call-ip6tables', value: '1' }
    - { name: 'net.ipv4.ip_forward', value: '1' }

- name: Install containerd
  apt:
    name: containerd
    state: present
    update_cache: yes

- name: Configure containerd
  shell: |
    mkdir -p /etc/containerd
    containerd config default > /etc/containerd/config.toml
    sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
    systemctl restart containerd
    systemctl enable containerd

- name: Install K8s prerequisites
  apt:
    name: [apt-transport-https, ca-certificates, curl, gpg]
    state: present

- name: Add K8s GPG key
  shell: curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.34/deb/Release.key | gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
  args:
    creates: /etc/apt/keyrings/kubernetes-apt-keyring.gpg

- name: Add K8s repository
  copy:
    dest: /etc/apt/sources.list.d/kubernetes.list
    content: 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.34/deb/ /'

- name: Install kubelet, kubeadm, kubectl
  apt:
    name:
      - kubelet=1.34.9-1.1
      - kubeadm=1.34.9-1.1
      - kubectl=1.34.9-1.1
    state: present
    update_cache: yes
    allow_downgrade: yes

- name: Hold K8s packages
  dpkg_selections:
    name: "{{ item }}"
    selection: hold
  loop:
    - kubelet
    - kubeadm
    - kubectl

