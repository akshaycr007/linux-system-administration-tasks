REQUIREMENT 
Configure the Kubernetes cluster with Master 1, Master 2, and Worker 1 and validate that the cluster is working properly.

step1 
Make the Kubernetes nodes use physical RAM directly instead of moving workload memory to swap.(every nodes) 
sudo swapoff -a
swapon --show

step2 
Allow Kubernetes/CNI networking and firewall rules to properly handle traffic passing through Linux bridges.(every nodes)
sudo modprobe overlay
sudo modprobe br_netfilter
verify
lsmod | grep -E 'overlay|br_netfilter'

step3 
Allow the Linux host to act as a router for Kubernetes/container traffic.Allow Kubernetes networking/firewall rules to correctly process bridged IPv4 traffic.
Ensure bridge traffic can be handled by the Linux IPv6 filtering layer.

sudo tee /etc/sysctl.d/99-kubernetes-cri.conf <<EOF
net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward = 1
EOF

step4 
Install the software that will actually execute containers on
sudo apt update
sudo apt install -y containerd
sudo systemctl status containerd
sudo systemctl enable containerd

step5
configuration 
sudo mkdir -p /etc/containerd
sudo containerd config default | sudo tee /etc/containerd/config.toml > /dev/null
sudo nano /etc/containerd/config.toml
SystemdCgroup = true
sudo sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml
verifygrep SystemdCgroup /etc/containerd/config.toml
sudo systemctl restart containerd
sudo systemctl status containerd
containerd --version

step6
Install kubeadm, kubelet and kubectl
sudo apt-get update
sudo apt-get install -y apt-transport-https ca-certificates curl gpg  (update ubuntus package information)
sudo mkdir -p -m 755 /etc/apt/keyrings
ls -ld /etc/apt/keyrings
curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.34/deb/Release.key | sudo gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
ls -l /etc/apt/keyrings/kubernetes-apt-keyring.gpg
echo 'deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.36/deb/ /' | sudo tee /etc/apt/sources.list.d/kubernetes.list
cat /etc/apt/sources.list.d/kubernetes.list

step7
sudo apt-get install -y kubelet kubeadm kubectl 
sudo apt-mark hold kubelet kubeadm kubectl
sudo systemctl enable --now kubelet
kubeadm version
kubelet --version
kubectl version --client

step8
master1 
control plane (master1) creating command 
sudo kubeadm init \
  --apiserver-advertise-address=172.30.7.131 \
  --control-plane-endpoint=172.30.7.131:6443 \
  --pod-network-cidr=192.168.0.0/16

step9
kubectl configuration for controlplane to kubectl connection 
mkdir -p $HOME/.kube
sudo cp -i /etc/kubernetes/admin.conf $HOME/.kube/config
sudo chown $(id -u):$(id -g) $HOME/.kube/config
verify 
kubectl cluster-info
kubectl get nodes 

step10 
installing container network interface 
kubectl apply -f https://raw.githubusercontent.com/projectcalico/calico/v3.31.2/manifests/calico.yaml
kubectl get pods -n kube-system

step11 
add master 2 on cluster used kubeadm join 
master1 
create token 
sudo kubeadm token create --print-join-command
sudo kubeadm init phase upload-certs --upload-certs\

master2
join command 
sudo kubeadm join 172.30.7.131:6443 \
  --token YOUR_NEW_TOKEN \
  --discovery-token-ca-cert-hash sha256:YOUR_HASH \
  --control-plane \
  --certificate-key YOUR_CERTIFICATE_KEY

mkdir -p $HOME/.kube
sudo cp -i /etc/kubernetes/admin.conf $HOME/.kube/config
sudo chown $(id -u):$(id -g) $HOME/.kube/config

step12 
worker setup 
master1
sudo kubeadm token create --print-join-command

worker1 
