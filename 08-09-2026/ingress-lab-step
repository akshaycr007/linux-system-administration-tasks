# ==========================================
# KONG INGRESS ROUTING WITH ENFORCED HTTPS
# ==========================================
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: akshay-kong-ingress
  namespace: webapp-ns
  annotations:
    konghq.com/strip-path: "true"
    konghq.com/protocols: "https"
    konghq.com/https-redirect-code: "301"
spec:
  ingressClassName: kong
  tls:
  - hosts:
    - devops-intern-webapp.luluex.com
    secretName: luluex-tls-secret
  rules:
  - host: devops-intern-webapp.luluex.com
    http:
      paths:
      - path: /app1
        pathType: Prefix
        backend: { service: { name: webapp1-service, port: { number: 80 } } }
      - path: /app2
        pathType: Prefix
        backend: { service: { name: webapp2-service, port: { number: 80 } } }
      - path: /app3
        pathType: Prefix
        backend: { service: { name: webapp3-service, port: { number: 80 } } }
      - path: /app4
        pathType: Prefix
        backend: { service: { name: webapp4-service, port: { number: 80 } } }
      - path: /app5
        pathType: Prefix
        backend: { service: { name: webapp5-service, port: { number: 80 } } }
---
# WEB APP 1
apiVersion: v1
kind: PersistentVolumeClaim
metadata: { name: webapp1-pvc, namespace: webapp-ns }
spec:
  accessModes: ["ReadWriteMany"]
  storageClassName: nfs-client
  resources: { requests: { storage: 1Gi } }
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: app1, namespace: webapp-ns }
spec:
  replicas: 1
  selector: { matchLabels: { app: app1 } }
  template:
    metadata: { labels: { app: app1 } }
    spec:
      containers:
      - name: nginx
        image: nginx:latest
        volumeMounts: [{ name: storage, mountPath: /usr/share/nginx/html }]
      volumes: [{ name: storage, persistentVolumeClaim: { claimName: webapp1-pvc } }]
---
apiVersion: v1
kind: Service
metadata: { name: webapp1-service, namespace: webapp-ns }
spec:
  type: ClusterIP
  ports: [{ port: 80, targetPort: 80 }]
  selector: { app: app1 }
---
