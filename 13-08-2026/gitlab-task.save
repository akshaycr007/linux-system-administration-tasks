step10 
jenkins create new pipeline 
app3-gitlab-ci

pipeline {
    agent any

    stages {

        stage('SSH to Server 1') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "hostname"
                '''
            }
        }

        stage('Clone GitLab Repository') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        rm -rf ~/linux-system-administration-tasks-gitlab &&
                        git clone \
                        git@gitlab.com:akshay852/linux-system-administration-tasks-gitlab.git \
                        ~/linux-system-administration-tasks-gitlab
                    "
                '''
            }
        }

        stage('Build Base Image') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        cd ~/linux-system-administration-tasks-gitlab/ci-cd-app3/image1-base &&
                        docker build -t akshaybase:gitlab-ci .
                    "
                '''
            }
        }

        stage('Build App1 Image') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        cd ~/linux-system-administration-tasks-gitlab/ci-cd-app3/image2-app1 &&
                        docker build -t akshayimage:gitlab-app1 .
                    "
                '''
            }
        }

        stage('Build App2 Image') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        cd ~/linux-system-administration-tasks-gitlab/ci-cd-app3/image3-app2 &&
                        docker build -t akshayimage:gitlab-app2 .
                    "
                '''
            }
        }

        stage('Build App3 Image') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        cd ~/linux-system-administration-tasks-gitlab/ci-cd-app3/image4-app3 &&
                        docker build -t akshayimage:gitlab-app3 .
                    "
                '''
            }
        }

        stage('Verify Images') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        docker images | grep -E 'akshaybase|akshayimage'
                    "
                '''
            }
        }

        stage('Tag Images for Docker Hub') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        docker tag akshaybase:gitlab-ci \
                            akshay852/akshaybase:gitlab-ci &&

                        docker tag akshayimage:gitlab-app1 \
                            akshay852/akshayimage:gitlab-app1 &&

                        docker tag akshayimage:gitlab-app2 \
                            akshay852/akshayimage:gitlab-app2 &&

                        docker tag akshayimage:gitlab-app3 \
                            akshay852/akshayimage:gitlab-app3
                    "
                '''
            }
        }

        stage('Push Images to Docker Hub') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        docker push akshay852/akshaybase:gitlab-ci &&
                        docker push akshay852/akshayimage:gitlab-app1 &&
                        docker push akshay852/akshayimage:gitlab-app2 &&
                        docker push akshay852/akshayimage:gitlab-app3
                    "
                '''
            }
        }
    }
}


step11 

create another pipeline as cd 

app3-gitlab-cd 


pipeline {
    agent any

    stages {

        stage('SSH to Server 1') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "hostname"
                '''
            }
        }

        stage('Clone GitLab Repository') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        rm -rf ~/app3-gitlab-deployment &&
                        git clone \
                        git@gitlab.com:akshay852/linux-system-administration-tasks-gitlab.git \
                        ~/app3-gitlab-deployment
                    "
                '''
            }
        }

        stage('Pull App3 Image') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        docker pull akshay852/akshayimage:gitlab-app3
                    "
                '''
            }
        }

        stage('Pull PostgreSQL Image') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        docker pull postgres:16
                    "
                '''
            }
        }

        stage('Stop Existing Deployment') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        cd ~/app3-gitlab-deployment/ci-cd-app3 &&
                        docker compose down
                    "
                '''
            }
        }

        stage('Deploy App3 and PostgreSQL') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        cd ~/app3-gitlab-deployment/ci-cd-app3 &&
                        docker compose up -d
                    "
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        cd ~/app3-gitlab-deployment/ci-cd-app3 &&
                        docker compose ps
                    "
                '''
            }
        }

        stage('Verify Containers') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        docker ps
                    "
                '''
            }
        }
    }
}
 















