pipeline {
    agent any

    stages {

        stage('SSH to Server 1') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "hostname"
                '''
            }
        }

        stage('Clone GitLab Repository') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        rm -rf ~/app3-gitlab-deployment &&
                        git clone \
                        git@gitlab.com:akshay852/linux-system-administration-tasks-gitlab.git \
                        ~/app3-gitlab-deployment
                    "
                '''
            }
        }

        stage('Pull App3 Image') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        docker pull akshay852/akshayimage:gitlab-app3
                    "
                '''
            }
        }

        stage('Pull PostgreSQL Image') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        docker pull postgres:16
                    "
                '''
            }
        }

        stage('Stop Existing Deployment') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        cd ~/app3-gitlab-deployment/ci-cd-app3 &&
                        docker compose down
                    "
                '''
            }
        }

        stage('Deploy App3 and PostgreSQL') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        cd ~/app3-gitlab-deployment/ci-cd-app3 &&
                        docker compose up -d
                    "
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        cd ~/app3-gitlab-deployment/ci-cd-app3 &&
                        docker compose ps
                    "
                '''
            }
        }

        stage('Verify Containers') {
            steps {
                sh '''
                    ssh ubuntu@172.30.7.144 "
                        docker ps
                    "
                '''
            }
        }
    }
}
 

