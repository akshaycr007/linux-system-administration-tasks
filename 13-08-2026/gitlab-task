.gitlab-ci.yml

stages:
  - ci

variables:
  SERVER1: "ubuntu@172.30.7.144"
  REPO: "git@gitlab.com:akshay852/linux-system-administration-tasks-gitlab.git"
  REPO_DIR: "/home/ubuntu/linux-system-administration-tasks-gitlab"

build-images:
  stage: ci

  tags:
    - gitlabrunner

  script:

    - echo "===== SSH TEST ====="
    - ssh "$SERVER1" "hostname"
    - ssh "$SERVER1" "whoami"

    - echo "===== CLONE GITLAB REPOSITORY ON SERVER 1 ====="
    - |
      ssh "$SERVER1" "
        rm -rf $REPO_DIR &&
        git clone $REPO $REPO_DIR
      "

    - echo "===== BUILD BASE IMAGE ====="
    - |
      ssh "$SERVER1" "
        cd $REPO_DIR/image1-base &&
        docker build -t akshaybase:gitlab-ci .
      "

    - echo "===== BUILD APP1 IMAGE ====="
    - |
      ssh "$SERVER1" "
        cd $REPO_DIR/image2-app1 &&
        docker build -t akshayimage:gitlab-app1 .
      "

    - echo "===== BUILD APP2 IMAGE ====="
    - |
      ssh "$SERVER1" "
        cd $REPO_DIR/image3-app2 &&
        docker build -t akshayimage:gitlab-app2 .
      "

    - echo "===== BUILD APP3 IMAGE ====="
    - |
      ssh "$SERVER1" "
        cd $REPO_DIR/image4-app3 &&
        docker build -t akshayimage:gitlab-app3 .
      "

    - echo "===== VERIFY IMAGES ====="
    - |
      ssh "$SERVER1" "
        docker images | grep -E 'akshaybase|akshayimage'
      "

    - echo "===== TAG IMAGES FOR DOCKER HUB ====="
    - |
      ssh "$SERVER1" "
        docker tag akshaybase:gitlab-ci akshay852/akshaybase:gitlab-ci &&
        docker tag akshayimage:gitlab-app1 akshay852/akshayimage:gitlab-app1 &&
        docker tag akshayimage:gitlab-app2 akshay852/akshayimage:gitlab-app2 &&
        docker tag akshayimage:gitlab-app3 akshay852/akshayimage:gitlab-app3
      "

    - echo "===== PUSH IMAGES TO DOCKER HUB ====="
    - |
      ssh "$SERVER1" "
        docker push akshay852/akshaybase:gitlab-ci &&
        docker push akshay852/akshayimage:gitlab-app1 &&
        docker push akshay852/akshayimage:gitlab-app2 &&
        docker push akshay852/akshayimage:gitlab-app3
      "

    - echo "===== CI COMPLETED ====="


