REQUIREMENET

Please ensure that only the app you developed is running on server1.
Rest of the application like, Jenkins, Gitlab, Prometheus, Grafana should be running on server2.
From Server2: Prometheus and Grafana should monitor all resources (server memory, CPU, storage, running containers) on server1 or any futher servers.
PS: You may use Jenkins/GitLab-related client tools if needed on server1 to deploy your application. 

SERVER1

step1 
docker rm -f prometheus Grafana

step2
docker ps

step3
cd ~/linux-system-administration-tasks-gitlab

step4 
Backup current compose file 

cp docker-compose.yml docker-compose.old.yml

step5
nano docker-compose.yml

services:

  app:
    image: akshay852/akshayimage:gitlab-app3
    container_name: app3-container
    ports:
      - "9091:80"
    depends_on:
      - postgres-db
    restart: unless-stopped

  postgres-db:
    image: postgres:16
    container_name: postgres-db
    environment:
      POSTGRES_USER: admin
      POSTGRES_PASSWORD: admin123
      POSTGRES_DB: appdb
    volumes:
      - postgres-data:/var/lib/postgresql/data
    restart: unless-stopped

  node-exporter:
    image: prom/node-exporter:latest
    container_name: node-exporter
    ports:
      - "9100:9100"
    volumes:
      - "/:/host:ro,rslave"
    restart: unless-stopped

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:latest
    container_name: cadvisor
    ports:
      - "8080:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro
    restart: unless-stopped

volumes:
  postgres-data:


step6 
docker compose up -d 

step7
verify 

curl http://localhost:9091
curl http://localhost:8080/metrics | head
curl http://localhost:9100/metrics | head

step8 
Test from server2 

curl http://172.30.7.144:9100/metrics
curl http://172.30.7.144:8080/metrics
curl http://172.30.7.144:9091/metrics.php


SERVER2 

step1

mkdir -p ~/monitoring
cd ~/monitoring

step2
nano docker-compose-monitoring.yml

services:

  prometheus:
    image: prom/prometheus:latest
    container_name: prometheus
    ports:
      - "9092:9090"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    restart: unless-stopped

  grafana:
    image: grafana/grafana:latest
    container_name: grafana
    ports:
      - "3001:3000"
    depends_on:
      - prometheus
    volumes:
      - grafana-data:/var/lib/grafana
    restart: unless-stopped

  blackbox-exporter:
    image: prom/blackbox-exporter:latest
    container_name: blackbox-exporter
    ports:
      - "9115:9115"
    restart: unless-stopped

volumes:
  prometheus-data:
  grafana-data:


step3
nano prometheus.yml

global:
  scrape_interval: 15s

scrape_configs:

  - job_name: "server1-node"
    static_configs:
      - targets: ["172.30.7.144:9100"]

  - job_name: "server1-cadvisor"
    static_configs:
      - targets: ["172.30.7.144:8080"]

  - job_name: "php-application"
    metrics_path: /metrics.php
    static_configs:
      - targets: ["172.30.7.144:9091"]

  - job_name: "application-url"
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - http://172.30.7.144:9091
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target

      - source_labels: [__param_target]
        target_label: instance

      - target_label: __address__
        replacement: blackbox-exporter:9115

step4
cd ~/monitoring
docker compose -f docker-compose-monitoring.yml up -d

step5
Remove GitLab Runner from Server 2

sudo gitlab-runner stop
sudo gitlab-runner uninstall
sudo apt remove gitlab-runner -y

SERVER1 
install gitlab-runner on server1

step1 
curl -L "https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.deb.sh" | sudo bash

step2
sudo apt install gitlab-runner -y

step3
sudo usermod -aG docker gitlab-runner
sudo -u gitlab-runner docker ps

step4
connect GitLab runner to gitlab

GitLab repository create a new gitlab-runner connected via authorized token

gitlab-runner register

step5 
updated .gitlab-ci.yml and  .gitlab-cd.yml run GitLab pipeline 

.gitlab-ci.yml 

stages:
  - build

build-images:
  stage: build

  tags:
    - gitlabrunner

  script:
    - echo "========================================"
    - echo "        CI STARTED"
    - echo "========================================"

    - echo "===== SERVER ====="
    - hostname
    - whoami

    - echo "===== DOCKER ====="
    - docker --version

    - echo "===== BUILD BASE IMAGE ====="
    - docker build -t akshaybase:gitlab-ci ./image1-base

    - echo "===== BUILD APP1 IMAGE ====="
    - docker build -t akshayimage:gitlab-app1 ./image2-app1

    - echo "===== BUILD APP2 IMAGE ====="
    - docker build -t akshayimage:gitlab-app2 ./image3-app2

    - echo "===== BUILD APP3 IMAGE ====="
    - docker build -t akshayimage:gitlab-app3 ./image4-app3

    - echo "===== VERIFY IMAGES ====="
    - docker images | grep -E 'akshaybase|akshayimage'

    - echo "===== TAG IMAGES ====="
    - docker tag akshaybase:gitlab-ci akshay852/akshaybase:gitlab-ci
    - docker tag akshayimage:gitlab-app1 akshay852/akshayimage:gitlab-app1
    - docker tag akshayimage:gitlab-app2 akshay852/akshayimage:gitlab-app2
    - docker tag akshayimage:gitlab-app3 akshay852/akshayimage:gitlab-app3

    - echo "===== PUSH TO DOCKER HUB ====="
    - docker push akshay852/akshaybase:gitlab-ci
    - docker push akshay852/akshayimage:gitlab-app1
    - docker push akshay852/akshayimage:gitlab-app2
    - docker push akshay852/akshayimage:gitlab-app3

    - echo "========================================"
    - echo "        CI COMPLETED"
    - echo "========================================"


.gitlab-cd.yml

stages:
  - deploy

deploy-application:
  stage: deploy

  tags:
    - gitlabrunner

  script:
    - echo "========================================"
    - echo "        CD STARTED"
    - echo "========================================"

    - hostname
    - whoami
    - docker --version
    - docker compose version

    - test -f docker-compose.yml
    - echo "docker-compose.yml found"

    - echo "===== PULL IMAGES ====="
    - docker compose pull

    - echo "===== DEPLOY APPLICATION ====="
    - docker compose up -d

    - echo "===== VERIFY APPLICATION ====="
    - curl -fsS http://localhost:9091/ > /dev/null
    - echo "Application is healthy"

    - echo "===== VERIFY POSTGRESQL ====="
    - docker exec postgres-db pg_isready -U admin -d appdb

    - echo "===== VERIFY NODE EXPORTER ====="
    - curl -fsS http://localhost:9100/metrics > /dev/null

    - echo "===== VERIFY CADVISOR ====="
    - curl -fsS http://localhost:8080/metrics > /dev/null

    - echo "===== FINAL STATUS ====="
    - docker compose ps

    - echo "========================================"
    - echo "        CD COMPLETED"
    - echo "========================================"


















