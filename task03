-----------------------
Configure the secondary 50 GB disk (/dev/sdb) by creating a 30 GB LVM partition, formatting it with ext4, and mounting it at /myhome with persistent mounting across reboots.

step1 
sudo fdisk /dev/sdb

step2
sudo pvcreate /dev/sdb1
sudo pvs

step3
sudo vgcreate myhome_vg /dev/sdb1
sudo vgs

step4 
sudo lvcreate -l 100%FREE -n myhome_lv myhome_vg
sudo lvs

step5
sudo mkfs.ext4 /dev/myhome_vg/myhome_lv

step6
sudo mkdir /myhome

step7 
sudo mount /dev/myhome_vg/myhome_lv /myhome

step8 
sudo blkid /dev/myhome_vg/myhome_lv
sudo nano /etc/fstab
UUID=<your-uuid>   /myhome   ext4   defaults   0   2

step9
