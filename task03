step14
creating a Dockerfile 

nano Dockerfile 

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y \
    nginx \
    php-fpm \
    curl \
    wget \
    unzip \
    libnginx-mod-http-modsecurity \
    modsecurity-crs

COPY app/ /var/www/html/

COPY default.conf /etc/nginx/sites-available/default

COPY start.sh /start.sh
 chmod +x /start.sh

EXPOSE 80

CMD ["/start.sh"]

